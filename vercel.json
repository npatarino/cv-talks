{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run slides:build",
  "outputDirectory": "_site",
  "installCommand": "bun install",
  "functions": {
    "api/remote.mjs": {
      "maxDuration": 10
    }
  },
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
